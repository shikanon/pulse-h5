{
  "name": "pulse-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write src server tests scripts vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.6.2",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  }
}
