# Server-only configuration. Export variables before npm run dev/start.
PULSE_API_ORIGIN=http://127.0.0.1:8787
PULSE_H5_ORIGIN=http://127.0.0.1:8080
PORT=8080
# Optional, development-only; use an isolated local API, never shared data.
# PULSE_DEV_USER=pulse.h5.e2e
# Configure consumer Apple Services ID only when accepted by pulse-api.
# PULSE_APPLE_WEB_CLIENT_ID=
